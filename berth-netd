#!/usr/bin/env bash
# berth-netd: keeps this Proxmox host's NAT in step with berth's containers.
#
# Runs on the hypervisor as a systemd service (berth-netd.service). It owns:
#
#   - the containers' IPv4 gateway (V4_GATEWAY on BRIDGE) and IP forwarding
#   - outbound NAT for V4_CIDR, so containers reach the internet over IPv4
#   - one DNAT rule per port forward, so PUBLIC_V4:<port> reaches a container
#   - root password login over SSH in each new container, once, so the
#     password berth shows its owner works (SSH_PASSWORD_LOGIN=0 to turn off)
#
# Where the forwards come from: berth writes them onto each container as
# Proxmox tags, "berth-<tcp|udp>-<public port>-<container port>" (the SSH port
# is one of them). This agent reads /etc/pve/lxc/*.conf every INTERVAL seconds
# and rebuilds its own iptables chains to match, so nothing on the host has to
# accept connections from berth or hold a berth secret.
#
# Trust: nothing reaches this agent over the network. berth writes tags through
# the Proxmox API (TLS, pinned certificate, API token), and the agent reads
# them from the local cluster filesystem. On top of Proxmox's own permissions:
#   - each container's port tags carry an HMAC-SHA256 signature
#     ("berth-sig-...") under NETD_KEY, a key only berth and this host hold,
#     over the vmid and the tags; unsigned or mis-signed forwards are ignored,
#     and signed tags copied onto another container do not verify
#   - a tag only names two ports; the destination address comes from the
#     container's own net0 and must be inside V4_CIDR
#   - the public port must be in PORT_MIN..PORT_MAX, so nothing can claim the
#     host's own SSH or web UI; containers outside VMID_MIN..VMID_MAX are ignored
#
# Everything lives in two chains, BERTH_PREROUTING and BERTH_POSTROUTING in the
# nat table, replaced atomically on each change. Other rules are left alone.
#
#   berth-netd run       the service loop (what systemd runs)
#   berth-netd --once    apply once and exit
#   berth-netd --print   print the rules it would apply; changes nothing
#   berth-netd --status  show the current chains and gateway
#   berth-netd --check   validate /etc/berth-netd.conf
#   berth-netd --configure-ssh  allow root password SSH in new containers now
#                        (the service does this by itself within seconds)
#   berth-netd --diagnose-ssh <vmid>  time each hop of an SSH login to one
#                        container, to see where a slow login spends its time
#   berth-netd --fingerprint  this host's API certificate, to compare with
#                        berth's PROXMOX_TLS_FINGERPRINT
#   berth-netd --remove  remove its chains and gateway address
set -uo pipefail

CONF="${BERTH_NETD_CONF:-/etc/berth-netd.conf}"
LXC_DIR="${BERTH_LXC_DIR:-/etc/pve/lxc}"
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

BRIDGE="${BRIDGE:-vmbr0}"
V4_CIDR="${V4_CIDR:-10.60.0.0/22}"
V4_GATEWAY="${V4_GATEWAY:-10.60.0.1}"
PUBLIC_V4="${PUBLIC_V4:-}"
PORT_MIN="${PORT_MIN:-20000}"
PORT_MAX="${PORT_MAX:-29999}"
VMID_MIN="${VMID_MIN:-3000}"
VMID_MAX="${VMID_MAX:-3999}"
IPV6_FORWARD="${IPV6_FORWARD:-1}"
# Shared with berth (its BERTH_NETD_KEY). Forwards are applied only when their
# signature checks out under this key.
NETD_KEY="${NETD_KEY:-}"
INTERVAL="${INTERVAL:-5}"
# Reapply even when nothing changed, in case something flushed the nat table.
RESYNC="${RESYNC:-60}"

PRE=BERTH_PREROUTING
POST=BERTH_POSTROUTING

log() { printf 'berth-netd: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }

valid_ip() {
  [[ $1 =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  local o
  for o in "${BASH_REMATCH[@]:1}"; do (( 10#$o <= 255 )) || return 1; done
}
ip2int() {
  local IFS=.
  # shellcheck disable=SC2086
  set -- $1
  echo $(( (10#$1 << 24) + (10#$2 << 16) + (10#$3 << 8) + 10#$4 ))
}
in_cidr() {
  local ip=$1 net=${2%/*} len=${2#*/} mask
  mask=$(( len == 0 ? 0 : (0xFFFFFFFF << (32 - len)) & 0xFFFFFFFF ))
  (( ($(ip2int "$ip") & mask) == ($(ip2int "$net") & mask) ))
}
is_int() { [[ $1 =~ ^[0-9]+$ ]]; }

check_config() {
  local bad=0
  [[ ${NETD_KEY,,} =~ ^[0-9a-f]{64}$ ]] \
    || { log "NETD_KEY must be the 64-hex-digit BERTH_NETD_KEY from berth's server/.env"; bad=1; }
  NETD_KEY=${NETD_KEY,,}
  valid_ip "$PUBLIC_V4" || { log "PUBLIC_V4 must be the host's public IPv4 (got '${PUBLIC_V4}')"; bad=1; }
  valid_ip "$V4_GATEWAY" || { log "V4_GATEWAY is not an IPv4 address: '$V4_GATEWAY'"; bad=1; }
  local cidr_net="" cidr_len=99
  # Copied out first: valid_ip runs its own match and overwrites BASH_REMATCH.
  if [[ $V4_CIDR =~ ^([0-9.]+)/([0-9]{1,2})$ ]]; then cidr_net=${BASH_REMATCH[1]}; cidr_len=$((10#${BASH_REMATCH[2]})); fi
  if [ -n "$cidr_net" ] && valid_ip "$cidr_net" && (( cidr_len <= 30 )); then
    valid_ip "$V4_GATEWAY" && ! in_cidr "$V4_GATEWAY" "$V4_CIDR" && { log "V4_GATEWAY $V4_GATEWAY is outside V4_CIDR $V4_CIDR"; bad=1; }
    valid_ip "$PUBLIC_V4" && in_cidr "$PUBLIC_V4" "$V4_CIDR" && { log "PUBLIC_V4 is inside V4_CIDR; that cannot be right"; bad=1; }
  else
    log "V4_CIDR must look like 10.60.0.0/22 (got '$V4_CIDR')"; bad=1
  fi
  local ints_ok=1
  for v in PORT_MIN PORT_MAX VMID_MIN VMID_MAX INTERVAL RESYNC; do
    is_int "${!v}" || { log "$v must be a whole number (got '${!v}')"; bad=1; ints_ok=0; }
  done
  if (( ints_ok )); then
    (( PORT_MIN >= 1024 && PORT_MAX <= 65535 && PORT_MIN <= PORT_MAX )) \
      || { log "PORT_MIN..PORT_MAX must lie within 1024..65535; keeping forwards off the host's own ports"; bad=1; }
    (( VMID_MIN <= VMID_MAX )) || { log "VMID_MIN must not exceed VMID_MAX"; bad=1; }
    (( INTERVAL >= 1 )) || { log "INTERVAL must be at least 1"; bad=1; }
  fi
  return $bad
}

# Prints "<ips> <tags>" for one container config: every ip= on a netN line of
# the main section (snapshots follow in [name] sections and are ignored).
read_conf() {
  awk '
    /^\[/ { exit }
    /^net[0-9]+:/ {
      line = $0; sub(/^net[0-9]+:[ \t]*/, "", line)
      n = split(line, kv, ",")
      for (i = 1; i <= n; i++) if (kv[i] ~ /^ip=/) {
        v = substr(kv[i], 4); sub(/\/.*/, "", v)
        if (v != "dhcp" && v != "manual") ips = ips (ips ? "," : "") v
      }
    }
    /^tags:/ { t = $0; sub(/^tags:[ \t]*/, "", t); tags = t }
    END { print (ips ? ips : "-"), (tags ? tags : "-") }
  ' "$1"
}

# Reads "<vmid> <port tags joined by ;> <signature>" lines and prints the
# vmids whose signature is right. One process for every container, with the
# key passed through the environment rather than argv (argv is visible in ps).
# The message format must match signatureTag() in berth's network.js.
verify_signatures() {
  NETD_KEY="$NETD_KEY" perl -MDigest::SHA=hmac_sha256_hex -ne '
    BEGIN { $key = pack("H*", $ENV{NETD_KEY}); }
    chomp; my ($vmid, $tags, $sig) = split / /;
    next unless defined $sig && $sig ne "-";
    my $want = substr(hmac_sha256_hex("berth-netd v1\n$vmid\n$tags", $key), 0, 32);
    # Constant-time comparison.
    my $diff = length($sig) ^ length($want);
    $diff |= ord(substr($sig, $_, 1)) ^ ord(substr($want, $_, 1)) for 0 .. length($want) - 1;
    print "$vmid\n" if $diff == 0;
  '
}

# One line per accepted forward: "<proto> <public port> <ip> <port> <vmid>".
collect() {
  local f vmid ips tags ip cand tag proto pub dst sig joined
  declare -A seen=() ct_ip=() ct_tags=() ok=()
  local -a order=() lines=()
  shopt -s nullglob

  # Pass 1: what each container in range asks for, and its signature.
  for f in "$LXC_DIR"/*.conf; do
    vmid=${f##*/}; vmid=${vmid%.conf}
    is_int "$vmid" || continue
    (( vmid >= VMID_MIN && vmid <= VMID_MAX )) || continue
    read -r ips tags < <(read_conf "$f")
    [ "$tags" = "-" ] && continue

    local -a port_tags=()
    sig="-"
    IFS=';, ' read -ra tag_list <<< "$tags"
    for tag in "${tag_list[@]}"; do
      if [[ $tag =~ ^berth-(tcp|udp)-[0-9]{1,5}-[0-9]{1,5}$ ]]; then port_tags+=("$tag")
      elif [[ $tag =~ ^berth-sig-([0-9a-f]{32})$ ]]; then sig=${BASH_REMATCH[1]}
      fi
    done
    (( ${#port_tags[@]} )) || continue
    joined=$(printf '%s\n' "${port_tags[@]}" | LC_ALL=C sort -u | paste -sd';' -)

    ip=""
    IFS=, read -ra cands <<< "$ips"
    for cand in "${cands[@]}"; do
      if [ "$cand" != "-" ] && valid_ip "$cand" && in_cidr "$cand" "$V4_CIDR"; then ip=$cand; break; fi
    done

    order+=("$vmid"); ct_ip[$vmid]=$ip; ct_tags[$vmid]=$joined
    lines+=("$vmid $joined $sig")
  done
  (( ${#order[@]} )) || return 0

  # Only forwards berth signed are applied.
  while read -r vmid; do [ -n "$vmid" ] && ok[$vmid]=1; done \
    < <(printf '%s\n' "${lines[@]}" | verify_signatures)

  # Pass 2: validate and emit.
  for vmid in "${order[@]}"; do
    if [ -z "${ok[$vmid]:-}" ]; then
      log "CT $vmid: forwards are unsigned or the signature is wrong (is NETD_KEY the same as berth's BERTH_NETD_KEY?); skipped"
      continue
    fi
    ip=${ct_ip[$vmid]}
    if [ -z "$ip" ]; then
      log "CT $vmid: has forwards but no address in $V4_CIDR; skipped"; continue
    fi
    IFS=';' read -ra tag_list <<< "${ct_tags[$vmid]}"
    for tag in "${tag_list[@]}"; do
      [[ $tag =~ ^berth-(tcp|udp)-([0-9]{1,5})-([0-9]{1,5})$ ]] || continue
      proto=${BASH_REMATCH[1]}; pub=$((10#${BASH_REMATCH[2]})); dst=$((10#${BASH_REMATCH[3]}))
      if (( pub < PORT_MIN || pub > PORT_MAX )); then
        log "CT $vmid: $tag: public port $pub is outside $PORT_MIN-$PORT_MAX; skipped"; continue
      fi
      if (( dst < 1 || dst > 65535 )); then
        log "CT $vmid: $tag: container port $dst is invalid; skipped"; continue
      fi
      if [ -n "${seen[$proto:$pub]:-}" ]; then
        log "CT $vmid: $tag: $proto port $pub already goes to CT ${seen[$proto:$pub]}; skipped"; continue
      fi
      seen[$proto:$pub]=$vmid
      echo "$proto $pub $ip $dst $vmid"
    done
  done
}

# The iptables-restore input. Declaring the two chains flushes and refills
# exactly them, atomically; --noflush leaves every other rule alone.
render() {
  local proto pub ip dst vmid
  echo "*nat"
  echo ":$PRE - [0:0]"
  echo ":$POST - [0:0]"
  # Containers out to the internet.
  echo "-A $POST -s $V4_CIDR ! -d $V4_CIDR -j MASQUERADE"
  # A container reaching another container through the public address:
  # without this the reply skips the host and the connection hangs.
  echo "-A $POST -s $V4_CIDR -d $V4_CIDR -m conntrack --ctstate DNAT -j MASQUERADE"
  while read -r proto pub ip dst vmid; do
    [ -n "${proto:-}" ] || continue
    echo "-A $PRE -d $PUBLIC_V4/32 -p $proto -m $proto --dport $pub -m comment --comment \"berth CT $vmid\" -j DNAT --to-destination $ip:$dst"
  done < <(collect)
  echo "COMMIT"
}

ensure_base() {
  sysctl -qw net.ipv4.ip_forward=1 >/dev/null
  if [ "$IPV6_FORWARD" = 1 ]; then sysctl -qw net.ipv6.conf.all.forwarding=1 >/dev/null; fi
  local len=${V4_CIDR#*/}
  if ! ip -4 -o addr show dev "$BRIDGE" 2>/dev/null | grep -qw "$V4_GATEWAY/$len"; then
    if ip addr add "$V4_GATEWAY/$len" dev "$BRIDGE"; then
      log "added gateway $V4_GATEWAY/$len on $BRIDGE"
    else
      log "could not add $V4_GATEWAY/$len on $BRIDGE"
    fi
  fi
}

ensure_jumps() {
  iptables -w -t nat -C PREROUTING -j "$PRE" 2>/dev/null || iptables -w -t nat -I PREROUTING 1 -j "$PRE"
  iptables -w -t nat -C POSTROUTING -j "$POST" 2>/dev/null || iptables -w -t nat -I POSTROUTING 1 -j "$POST"
}

apply() {
  local payload=$1
  printf '%s\n' "$payload" | iptables-restore -w --noflush || return 1
  ensure_jumps
}

count_forwards() { grep -c -- "-j DNAT" <<< "$1" || true; }

remove() {
  iptables -w -t nat -D PREROUTING -j "$PRE" 2>/dev/null
  iptables -w -t nat -D POSTROUTING -j "$POST" 2>/dev/null
  for c in "$PRE" "$POST"; do
    iptables -w -t nat -F "$c" 2>/dev/null
    iptables -w -t nat -X "$c" 2>/dev/null
  done
  ip addr del "$V4_GATEWAY/${V4_CIDR#*/}" dev "$BRIDGE" 2>/dev/null
  log "removed $PRE, $POST and $V4_GATEWAY on $BRIDGE (IP forwarding left on)"
}

# The SHA-256 fingerprint of the certificate the Proxmox API serves, read from
# disk here on the host, so it can be compared with the PROXMOX_TLS_FINGERPRINT
# berth pinned over the network. If they differ, something is in between.
fingerprint() {
  local f=/etc/pve/local/pveproxy-ssl.pem
  [ -r "$f" ] || f=/etc/pve/local/pve-ssl.pem
  [ -r "$f" ] || die "no Proxmox certificate found under /etc/pve/local"
  openssl x509 -noout -fingerprint -sha256 -in "$f" | sed 's/^.*=//'
}

# ---- root password login over SSH -------------------------------------------
#
# berth sets a random root password on every container and shows it to the
# owner, but Debian's and Ubuntu's SSH servers refuse root password logins by
# default, so that password could not be used over SSH. Once per container,
# right after it is first seen running, this writes a drop-in that allows it.
#
# Done from the host with `pct exec`, which needs no network access to the
# container and no credentials. Only containers whose forwards carry a valid
# berth signature are touched, and the command run is fixed: nothing from a
# tag reaches it. A marker inside the container means it is done exactly once;
# change or delete the drop-in afterwards and it stays that way. A reinstall
# is a new filesystem without the marker, so it is configured again.

# Runs INSIDE the container, as root. R is a root prefix for tests only.
read -r -d '' SSH_SCRIPT <<'SCRIPT'
PATH=/usr/sbin:/usr/bin:/sbin:/bin
R=${R:-}
marker="$R/var/lib/berth/ssh-password-login"
cfg="$R/etc/ssh/sshd_config"
dropin="$R/etc/ssh/sshd_config.d/00-berth.conf"
[ -e "$marker" ] && { echo already; exit 0; }
[ -f "$cfg" ] || { echo no-sshd; exit 0; }
mkdir -p "$R/etc/ssh/sshd_config.d"
# The first value sshd reads for a setting wins, so the drop-ins must be
# included before the main file's own settings: at the top.
if ! grep -Eqi '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/' "$cfg"; then
  sed -i '1i Include /etc/ssh/sshd_config.d/*.conf' "$cfg"
fi
cat > "$dropin" <<'EOF'
# Written once by berth-netd so the root password shown on berth's Password
# tab works over SSH. Edit or delete it freely: berth-netd will not touch this
# container's SSH configuration again.
PermitRootLogin yes
PasswordAuthentication yes
KbdInteractiveAuthentication yes
# Two common causes of a login that hangs for seconds before the password
# prompt: a reverse DNS lookup of the client, and a GSSAPI/Kerberos attempt
# (RHEL-family templates ship with GSSAPIAuthentication yes). Both are off.
UseDNS no
GSSAPIAuthentication no
EOF
# Never leave a configuration sshd refuses: that would lock everyone out.
if [ -z "$R" ] && command -v sshd >/dev/null 2>&1 && ! sshd -t >/dev/null 2>&1; then
  rm -f "$dropin"; echo invalid; exit 4
fi
if [ -z "$R" ]; then
  { systemctl reload ssh || systemctl reload sshd || rc-service sshd restart || service ssh reload; } >/dev/null 2>&1 || true
fi
mkdir -p "$R/var/lib/berth" && : > "$marker"
echo changed
SCRIPT

SSH_PASSWORD_LOGIN="${SSH_PASSWORD_LOGIN:-1}"
# The in-container step takes well under a second; a container whose init is
# wedged must not hold the NAT loop, and everyone else's forwards, hostage.
SSH_EXEC_TIMEOUT="${SSH_EXEC_TIMEOUT:-20}"
declare -A SSH_DONE=() SSH_RETRY_AT=() SSH_FAILS=()

# A container's identity across reinstalls: its MAC changes when it is recreated.
ct_identity() { awk '/^\[/ { exit } /^net0:/ { if (match($0, /hwaddr=[0-9A-Fa-f:]+/)) print substr($0, RSTART + 7, RLENGTH - 7); exit }' "$1"; }

# The vmids of the running containers, one line each, from a single cheap
# process. `pct status` loads the PVE Perl stack and costs about half a second
# per call; asked once per container per pass, with the loop blocked
# meanwhile, that alone could stretch a 5-second pass into a 30-second one on
# a host with a few dozen stopped containers. lxc-ls answers for all of them
# in milliseconds; `pct list` is the one-process fallback.
running_cts() {
  if command -v lxc-ls >/dev/null 2>&1; then lxc-ls --running -1 2>/dev/null
  else pct list 2>/dev/null | awk 'NR > 1 && $2 == "running" { print $1 }'
  fi
}
ct_running() { running_cts | grep -qx "$1"; }

# One pass over the containers whose forwards are signed (their vmids are in
# the rule comments of the payload just applied).
configure_ssh() {
  local payload=$1 vmid id out rc now entry fails delay
  local -a pending=()
  declare -A up=()
  [ "$SSH_PASSWORD_LOGIN" = 1 ] || return 0
  now=$(date +%s)
  for vmid in $(grep -o 'berth CT [0-9]*' <<< "$payload" | awk '{ print $3 }' | sort -un); do
    id=$(ct_identity "$LXC_DIR/$vmid.conf"); id=${id:-unknown}
    [ "${SSH_DONE[$vmid]:-}" = "$id" ] && continue
    (( now >= ${SSH_RETRY_AT[$vmid]:-0} )) || continue
    pending+=("$vmid:$id")
  done
  (( ${#pending[@]} )) || return 0
  while read -r vmid; do [ -n "$vmid" ] && up[$vmid]=1; done < <(running_cts)
  for entry in "${pending[@]}"; do
    vmid=${entry%%:*}; id=${entry#*:}
    # A stopped container costs nothing to look at again next pass, so a new
    # one is configured on the first pass after it starts.
    [ -n "${up[$vmid]:-}" ] || continue
    out=$(timeout "$SSH_EXEC_TIMEOUT" pct exec "$vmid" -- sh -c "$SSH_SCRIPT" 2>&1); rc=$?
    case "$rc:$out" in
      0:*changed)  log "CT $vmid: allowed root password login over SSH"; SSH_DONE[$vmid]=$id ;;
      0:*already)  SSH_DONE[$vmid]=$id ;;
      0:*no-sshd)  log "CT $vmid: no SSH server installed; nothing to configure"; SSH_DONE[$vmid]=$id ;;
      4:*)         log "CT $vmid: sshd rejected the change, so it was rolled back; will not retry"; SSH_DONE[$vmid]=$id ;;
      *)
        # 1, 2, 4, 8 minutes, then every 15: a container that never answers
        # is looked at less and less often.
        fails=$(( ${SSH_FAILS[$vmid]:-0} + 1 )); SSH_FAILS[$vmid]=$fails
        delay=$(( 60 << (fails - 1) )); (( delay > 900 )) && delay=900
        if (( rc == 124 )); then
          log "CT $vmid: pct exec did not finish within ${SSH_EXEC_TIMEOUT}s; retrying in $((delay / 60)) min"
        else
          log "CT $vmid: could not configure SSH yet (exit $rc); retrying in $((delay / 60)) min"
        fi
        SSH_RETRY_AT[$vmid]=$((now + delay)) ;;
    esac
  done
}

# ---- where does a slow SSH login spend its time? ----------------------------
#
# Times each hop between a client and sshd in one container, from the host:
# the forward, the TCP path to the container, and then, inside it, the things
# that run between "connected" and a shell prompt (sshd's settings, PAM's
# session setup, DNS, the login messages). Prints what it finds; changes
# nothing in the container.

# Runs INSIDE the container. Each line is "<what> <milliseconds> <detail>".
read -r -d '' SSH_DIAG_SCRIPT <<'SCRIPT'
PATH=/usr/sbin:/usr/bin:/sbin:/bin
now() { read -r u _ < /proc/uptime; echo "${u%.*}${u#*.}0"; }
took() { echo $(( $(now) - $1 )); }
if command -v sshd >/dev/null 2>&1; then
  echo "sshd-settings 0 $(sshd -T 2>/dev/null | grep -Ei '^(usedns|gssapiauthentication|usepam|permitrootlogin|passwordauthentication) ' | tr '\n' ' ')"
else
  echo "sshd-settings 0 (sshd not installed)"
fi
if command -v systemctl >/dev/null 2>&1; then
  t=$(now); s=$(timeout 10 systemctl is-active systemd-logind 2>/dev/null || echo unknown)
  echo "logind $(took "$t") $s"
  echo "ssh-unit 0 $(systemctl is-active ssh sshd 2>/dev/null | tr '\n' ' ')"
fi
if command -v getent >/dev/null 2>&1; then
  t=$(now); timeout 10 getent hosts deb.debian.org >/dev/null 2>&1 && r=ok || r=failed
  echo "dns $(took "$t") $r $(grep -E '^nameserver' /etc/resolv.conf 2>/dev/null | tr '\n' ' ')"
fi
if [ -d /etc/update-motd.d ] && command -v run-parts >/dev/null 2>&1; then
  t=$(now); timeout 30 run-parts /etc/update-motd.d >/dev/null 2>&1
  echo "motd $(took "$t") $(ls /etc/update-motd.d | tr '\n' ' ')"
fi
SCRIPT

# EPOCHREALTIME uses the locale's decimal separator ("1794843283,936155" under
# de_DE), so strip either one.
ms_now() { echo $(( ${EPOCHREALTIME//[.,]/} / 1000 )); }

# Every character typed is a round trip: client -> host -> container -> back.
# The NAT adds nothing measurable. What does is the container waiting for a
# CPU (cores/cpulimit, or a busy host), memory pressure in it, the uplink's
# queue filling behind someone's upload, or simply the distance to the
# client. The first three can be seen from here, through the cgroup files
# that Proxmox keeps per container, without entering it.
typing_latency() {
  local vmid=$1 ip=$2 rtt v up port kinds cg
  cg="/sys/fs/cgroup/lxc/$vmid"
  echo "keystroke path (each character is a round trip client -> host -> container -> back):"
  rtt=$(ping -c 3 -i 0.2 -W 1 -q "$ip" 2>/dev/null | awk -F'[/ ]' '/^rtt/ { print $8 }')
  if [ -n "$rtt" ]; then
    printf '  host -> container ping: %s ms avg%s\n' "$rtt" \
      "$(awk -v r="$rtt" 'BEGIN { if (r > 2) printf "  <- within one host this should be well under 1 ms: the container is slow to get a CPU" }')"
  else
    echo "  host -> container ping: no reply"
  fi
  v=$(awk '/^\[/ { exit } /^(cores|cpulimit|cpuunits|memory|swap):/ { printf "%s ", $0 }' "$LXC_DIR/$vmid.conf")
  echo "  limits: ${v:-none set (host defaults)}"
  if [ -r "$cg/cpu.pressure" ]; then
    echo "  cpu pressure (time spent waiting for a CPU, last 10 s / 60 s): $(awk '/^some/ { sub(/avg10=/, "", $2); sub(/avg60=/, "", $3); printf "%s%% / %s%%", $2, $3; if ($2 + 0 > 10) printf "  <- starved: raise cores or cpulimit, or the host is overloaded" }' "$cg/cpu.pressure")"
    [ -r "$cg/cpu.stat" ] && echo "  cpulimit throttling: $(awk '/^nr_throttled/ { n = $2 } /^throttled_usec/ { t = $2 } END { printf "%d times, %.1f s in total", n, t / 1e6; if (n > 0) printf "  <- it keeps hitting its cpulimit" }' "$cg/cpu.stat")"
    [ -r "$cg/memory.pressure" ] && echo "  memory pressure (last 10 s): $(awk '/^some/ { sub(/avg10=/, "", $2); printf "%s%%", $2; if ($2 + 0 > 5) printf "  <- reclaiming or swapping: raise memory, or find what fills it" }' "$cg/memory.pressure")"
  fi
  [ -r /proc/pressure/cpu ] && echo "  host cpu pressure (last 10 s): $(awk '/^some/ { sub(/avg10=/, "", $2); printf "%s%%", $2; if ($2 + 0 > 10) printf "  <- the host itself is short of CPU, so everything on it lags" }' /proc/pressure/cpu)"
  up=$(ip -4 route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
  # The queue that matters is on the physical port behind the bridge.
  for port in $(ls "/sys/class/net/$up/brif" 2>/dev/null || echo "$up"); do
    [ -n "$port" ] || continue
    kinds=$(tc qdisc show dev "$port" 2>/dev/null | awk '{ print $2 }' | sort -u | paste -sd, -)
    printf '  uplink %s: qdisc %s, tx drops %s%s\n' "$port" "${kinds:-?}" "$(cat "/sys/class/net/$port/statistics/tx_dropped" 2>/dev/null || echo ?)" \
      "$(case ",$kinds," in *,pfifo_fast,*) echo "  <- no fair queuing: one container's upload delays everyone's keystrokes; tc qdisc replace dev $port root fq_codel" ;; esac)"
  done
  echo "  from the client: 'ping $PUBLIC_V4' is the floor for every keystroke, and the host cannot lower it; 'mtr $PUBLIC_V4' shows where delay or loss is added on the way"
}

diagnose_ssh() {
  local vmid=$1 ip="" fwd="" proto pub v dst owner t out what ms detail
  is_int "$vmid" || die "usage: berth-netd --diagnose-ssh <vmid>"
  [ -f "$LXC_DIR/$vmid.conf" ] || die "CT $vmid: no config in $LXC_DIR"
  while read -r proto pub v dst owner; do
    [ "$owner" = "$vmid" ] || continue
    ip=$v; [ "$proto:$dst" = tcp:22 ] && fwd="$PUBLIC_V4:$pub"
  done < <(collect 2>/dev/null)
  if [ -z "$ip" ]; then
    echo "CT $vmid: no signed forwards (see 'berth-netd --print'); its SSH port is not reachable through this host"
    return 1
  fi
  echo "CT $vmid: $ip, SSH forward ${fwd:-none (no signed tcp forward to port 22)}"
  if ! ct_running "$vmid"; then echo "CT $vmid is not running"; return 1; fi
  echo
  echo "host:"
  echo "  load: $(cut -d' ' -f1-3 /proc/loadavg)"
  if [ -r /proc/sys/net/netfilter/nf_conntrack_count ]; then
    echo "  conntrack: $(cat /proc/sys/net/netfilter/nf_conntrack_count) of $(cat /proc/sys/net/netfilter/nf_conntrack_max) entries (a full table drops packets: 'table full' in dmesg)"
  fi
  echo "  mtu: $BRIDGE $(cat "/sys/class/net/$BRIDGE/mtu" 2>/dev/null || echo ?), veth${vmid}i0 $(cat "/sys/class/net/veth${vmid}i0/mtu" 2>/dev/null || echo ?)"
  if [ -n "$fwd" ]; then
    echo "  forward hits: $(iptables -w -t nat -L "$PRE" -v -n -x 2>/dev/null | awk -v p="dpt:$pub" '$0 ~ p { print $1 " packets"; f = 1 } END { if (!f) print "rule not found" }')"
  fi
  echo
  typing_latency "$vmid" "$ip"
  echo
  # Time to sshd's banner, straight to the container: the network path and
  # sshd's accept, with no authentication involved.
  t=$(ms_now)
  out=$(timeout 5 bash -c "exec 3<>/dev/tcp/$ip/22 && head -c 64 <&3" 2>/dev/null | head -1 | tr -d '\r')
  ms=$(( $(ms_now) - t ))
  if [ -z "$out" ]; then
    (( ms >= 5000 )) && out="no SSH banner within 5s (packets lost, or sshd stuck before greeting)" \
      || out="connection refused: nothing listening on port 22 in the container"
  fi
  printf 'host -> %s:22  %5d ms  %s\n' "$ip" "$ms" "$out"
  t=$(ms_now)
  out=$(timeout 60 pct exec "$vmid" -- sh -c "$SSH_DIAG_SCRIPT" 2>&1)
  printf 'pct exec round trip  %5d ms\n' "$(( $(ms_now) - t ))"
  echo
  echo "inside CT $vmid (what runs between connecting and the prompt):"
  while read -r what ms detail; do
    [ -n "$what" ] || continue
    case "$what" in
      sshd-settings) echo "  sshd: $detail" ;;
      logind)   printf '  systemd-logind: %s, answered in %d ms%s\n' "$detail" "$ms" "$( (( ms > 1000 )) && echo '  <- PAM waits on this at every login')" ;;
      ssh-unit) echo "  ssh service: $detail" ;;
      dns)      printf '  dns lookup: %d ms, %s%s\n' "$ms" "$detail" "$( (( ms > 1000 )) && echo '  <- slow or broken resolver; login hooks that look names up wait on it')" ;;
      motd)     printf '  login messages (update-motd.d): %d ms%s\n     %s\n' "$ms" "$( (( ms > 500 )) && echo '  <- these run at every login; disable the slow ones')" "$detail" ;;
      *)        echo "  $what $ms $detail" ;;
    esac
  done <<< "$out"
  echo
  echo "From the client, 'ssh -vvv -p ${fwd##*:} root@$PUBLIC_V4' shows the same login with timestamps between the steps."
}

status() {
  echo "gateway:"; ip -4 -o addr show dev "$BRIDGE" | grep -w "$V4_GATEWAY" || echo "  (missing)"
  echo "ip_forward: $(cat /proc/sys/net/ipv4/ip_forward)  ipv6 forwarding: $(cat /proc/sys/net/ipv6/conf/all/forwarding)"
  echo; iptables -w -t nat -S "$POST" 2>/dev/null || echo "$POST: missing"
  echo; iptables -w -t nat -S "$PRE" 2>/dev/null || echo "$PRE: missing"
}

run() {
  local last="" last_at=0 payload now n warn last_warn="" warnfile
  warnfile=$(mktemp)
  log "watching $LXC_DIR (CT $VMID_MIN-$VMID_MAX, ports $PORT_MIN-$PORT_MAX, $V4_CIDR via $V4_GATEWAY on $BRIDGE, public $PUBLIC_V4)"
  trap 'rm -f "$warnfile"; log "stopping; rules stay in place"; exit 0' TERM INT
  while true; do
    ensure_base
    payload=$(render 2>"$warnfile")
    # Skipped-forward warnings repeat every pass; log them only when they change.
    warn=$(cat "$warnfile")
    if [ "$warn" != "$last_warn" ]; then
      [ -n "$warn" ] && printf '%s\n' "$warn" >&2
      last_warn=$warn
    fi
    now=$(date +%s)
    if [ "$payload" != "$last" ] || (( now - last_at >= RESYNC )); then
      if apply "$payload"; then
        if [ "$payload" != "$last" ]; then
          n=$(count_forwards "$payload")
          log "applied $n forward(s)"
        fi
        last=$payload; last_at=$now
      else
        log "iptables-restore failed; will retry"
      fi
    fi
    configure_ssh "$last"
    sleep "$INTERVAL" & wait $!
  done
}

case "${1:-run}" in
  run)       check_config || exit 1; run ;;
  --once)    check_config || exit 1; ensure_base; p=$(render); apply "$p" && log "applied $(count_forwards "$p") forward(s)" ;;
  --print)   check_config || exit 1; render ;;
  --configure-ssh) check_config || exit 1; configure_ssh "$(render 2>/dev/null)" ;;
  --diagnose-ssh) check_config || exit 1; diagnose_ssh "${2:-}" ;;
  --ssh-script) printf '%s\n' "$SSH_SCRIPT" ;;
  --check)   check_config && echo "config ok: $CONF" ;;
  --fingerprint) fingerprint ;;
  --status)  status ;;
  --remove)  remove ;;
  -h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0" ;;
  *)         die "unknown command '$1' (try --help)" ;;
esac
